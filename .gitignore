# Obsidian 工作区 UI 状态（本地缓存，换设备/换时间会变）
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian 内部缓存
.obsidian/cache/
.obsidian/types/

# Obsidian 软删除目录
.trash/

# 插件二进制 / 样式 / 脚本（从 GitHub release 重新安装即可，节省仓库体积）
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/*.sh

# 插件配置（含可能的凭证，绝不入库）
.obsidian/plugins/*/data.json

# 操作系统临时文件
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# 编辑器临时文件
*.swp
*.swo
*~
*.tmp
*.bak
